@using SqlServerChallenges.Core.Services.SchemaReader
@model IReadOnlyDictionary<string, IReadOnlyList<ColumnInfo>>

@if (Model.Count == 0)
{
    <p class="schema-accordion__empty">No table definitions available.</p>
}
else
{
    <div class="schema-accordion">
        @foreach (var (tableIdentifier, columns) in Model)
        {
            var targetId = "schema-tbl-" + tableIdentifier.Replace(".", "-");
            <div class="schema-acc__item">
                <button class="schema-acc__header collapsed" type="button"
                        data-bs-toggle="collapse" data-bs-target="#@targetId"
                        aria-expanded="false" aria-controls="@targetId">
                    <i class="bi bi-table me-1" aria-hidden="true"></i>
                    <span>@tableIdentifier</span>
                    <i class="bi bi-chevron-down ms-auto schema-acc__chevron" aria-hidden="true"></i>
                </button>
                <div id="@targetId" class="schema-acc__body collapse">
                    <ul class="schema-acc__columns">
                        @foreach (var column in columns)
                        {
                            <li class="schema-acc__column">
                                <span class="schema-acc__column-name">@column.Name</span>
                                <span class="schema-acc__column-type">@column.Type</span>
                                <span class="schema-acc__column-null" title="Nullability">
                                    @(column.IsNullable ? "NULL" : "NOT NULL")
                                </span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }
    </div>
}