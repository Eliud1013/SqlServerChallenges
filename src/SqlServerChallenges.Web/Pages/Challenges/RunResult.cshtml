@using SqlServerChallenges.Core.Features.Submissions.RunUserSql
@using SqlServerChallenges.Core.Services.QueryExecutor
@model RunResult

@if (!Model.IsSuccess)
{
    <div class="run-result__error">
        <i class="bi bi-exclamation-triangle run-result__error-icon"></i>
        <span class="run-result__error-text">
            @(Model.ErrorType switch
            {
                QueryErrorType.QueryTimeout => "Query timed out (6s limit)",
                QueryErrorType.PermissionDenied => "Permission denied",
                _ => "An error occurred while executing the query"
            })
        </span>
    </div>
    return;
}

<div class="run-result">
    <div class="run-result__cards">
        <div class="run-result__card @(Model.ColumnCountMatch ? "run-result__card--ok" : "run-result__card--fail")">
            <div class="run-result__card-header">
                <i class="bi bi-columns-gap"></i>
                <span>Columns</span>
            </div>
            <div class="run-result__card-body">
                <span class="run-result__big @(Model.ColumnCountMatch ? "run-result__big--ok" : "run-result__big--fail")">
                    @Model.UserColumns.Count
                </span>
                <span class="run-result__sep">/</span>
                <span class="run-result__big run-result__big--expected">@Model.ExpectedColumns.Count</span>
            </div>
            <div class="run-result__card-label">
                @(Model.ColumnCountMatch ? "Match" : $"Expected {@Model.ExpectedColumns.Count} columns")
            </div>
        </div>

        <div class="run-result__card @(Model.ColumnsMatch ? "run-result__card--ok" : "run-result__card--fail")">
            <div class="run-result__card-header">
                <i class="bi bi-tag"></i>
                <span>Column Names</span>
            </div>
            <div class="run-result__card-body">
                <span class="run-result__big @(Model.ColumnsMatch ? "run-result__big--ok" : "run-result__big--fail")">
                    @(Model.ColumnsMatch ? "✓" : "✗")
                </span>
            </div>
            <div class="run-result__card-label">
                @(Model.ColumnsMatch ? "All names match" : "Names differ")
            </div>
        </div>

        <div class="run-result__card @(Model.RowCountMatch ? "run-result__card--ok" : "run-result__card--fail")">
            <div class="run-result__card-header">
                <i class="bi bi-list-ol"></i>
                <span>Rows</span>
            </div>
            <div class="run-result__card-body">
                <span class="run-result__big @(Model.RowCountMatch ? "run-result__big--ok" : "run-result__big--fail")">
                    @Model.UserRowCount
                </span>
                <span class="run-result__sep">/</span>
                <span class="run-result__big run-result__big--expected">@Model.ExpectedRowCount</span>
            </div>
            <div class="run-result__card-label">
                @(Model.RowCountMatch ? "Match" : $"Expected {@Model.ExpectedRowCount} rows")
            </div>
        </div>
    </div>

    <!-- Column names detail (only if they differ) -->
    @if (!Model.ColumnsMatch)
    {
        <div class="run-result__section">
            <div class="run-result__section-title">
                <i class="bi bi-diagram-3 me-1"></i>Column Comparison
            </div>
            <div class="run-result__col-compare">
                <div class="run-result__col-list">
                    <span class="run-result__col-label">Yours</span>
                    @foreach (var col in Model.UserColumns)
                    {
                        var match = Model.ExpectedColumns.Contains(col, StringComparer.OrdinalIgnoreCase);
                        <code class="run-result__col-name @(match ? "run-result__col-name--ok" : "run-result__col-name--fail")">
                            @col
                        </code>
                    }
                </div>
                <div class="run-result__col-list">
                    <span class="run-result__col-label">Expected</span>
                    @foreach (var col in Model.ExpectedColumns)
                    {
                        var match = Model.UserColumns.Contains(col, StringComparer.OrdinalIgnoreCase);
                        <code class="run-result__col-name @(match ? "run-result__col-name--ok" : "run-result__col-name--miss")">
                            @col
                        </code>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Rows table -->
    <div class="run-result__section">
        <div class="run-result__section-title">
            <i class="bi bi-table me-1"></i>Result (@Model.UserRowCount rows)
        </div>
        <div class="run-result__table-wrap">
            <table class="table table-sm table-borderless mb-0">
                <thead>
                    <tr>
                        <th class="run-result__th-status"></th>
                        @foreach (var col in Model.UserColumns)
                        {
                            <th>@col</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.UserRows.Count; i++)
                    {
                        var matched = Model.IsRowMatch(i);
                        var userRow = Model.UserRows[i];
                        <tr class="@(matched ? "run-result__row--ok" : "run-result__row--fail")">
                            <td class="run-result__td-status">
                                @if (matched)
                                {
                                    <i class="bi bi-check-circle-fill run-result__status--ok"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill run-result__status--fail"></i>
                                }
                            </td>
                            @foreach (var col in Model.UserColumns)
                            {
                                var cellValue = userRow.TryGetValue(col, out var v) ? v?.ToString() : null;
                                <td>@(string.IsNullOrEmpty(cellValue) ? "-" : cellValue)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
