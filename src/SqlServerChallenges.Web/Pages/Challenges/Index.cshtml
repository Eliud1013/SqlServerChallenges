@page
@using SqlServerChallenges.Core.Data.Entities.Challenges
@model SqlServerChallenges.Web.Pages.Challenges.ListChallenges.Index
@{
    ViewData["Title"] = "Challenges";
}

@section Styles {
    <link rel="stylesheet" href="~/css/Challenges/Index.css" asp-append-version="true"/>
}

<section class="position-relative w-100 px-5 mb-2">
    <div class="challenges-page__glow challenges-page__glow--left z-2" aria-hidden="true"></div>
    <div class="challenges-page__glow challenges-page__glow--right z-2" aria-hidden="true"></div>

    <div class="position-relative z-1 d-flex flex-column gap-4">
        <header class="challenges-page__stats d-flex flex-column gap-1">
            <h1 class="fw-bold h2 mb-0">Challenges</h1>
            <p class="d-flex flex-wrap align-items-center gap-2 mb-0 small">
                <span>@Model.TotalChallenges total</span>
                <span class="challenges-page__stat challenges-page__stat--easy">@Model.EasyCount easy</span>
                <span class="challenges-page__stat challenges-page__stat--medium">@Model.MediumCount medium</span>
                <span class="challenges-page__stat challenges-page__stat--hard">@Model.HardCount hard</span>
            </p>
        </header>

        <div class="row g-3 align-items-center mb-2">
            <div class="col-12 col-lg-4">
                <label class="challenges-page__search">
                    <span class="visually-hidden">Search challenges</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" class="challenges-page__search-icon">
                        <path d="M21 21l-4.35-4.35" stroke="currentColor" stroke-width="1.8"
                              stroke-linecap="round"/>
                        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.8"/>
                    </svg>
                    <input type="search"
                           name="Title"
                           id="filter-title"
                           hx-get="?handler=UpdateList"
                           hx-trigger="keyup changed delay:400ms"
                           hx-target="#challengesAccordion"
                           hx-include="#filter-category, #filter-difficulty"
                           placeholder="Search challenges..." aria-label="Search challenges"/>
                </label>
            </div>

            <div class="col-12 col-lg-5">
                <div class="challenges-page__segmented" role="tablist" aria-label="Difficulty filters">
                    <input type="hidden" id="filter-difficulty" name="Difficulty" value=""/>
                    <button type="button"
                            data-difficulty=""
                            onclick="document.getElementById('filter-difficulty').value = ''"
                            class="challenges-page__segmented-item is-active"
                            hx-get="?handler=UpdateList"
                            hx-target="#challengesAccordion"
                            hx-include="#filter-title, #filter-category, #filter-difficulty"
                            aria-pressed="true">All
                    </button>

                    <button type="button"
                            onclick="document.getElementById('filter-difficulty').value = '@ChallengeDifficulty.Easy'"
                            class="challenges-page__segmented-item"
                            hx-get="?handler=UpdateList"
                            hx-target="#challengesAccordion"
                            hx-include="#filter-title, #filter-category, #filter-difficulty">Easy
                    </button>

                    <button type="button"
                            onclick="document.getElementById('filter-difficulty').value = '@ChallengeDifficulty.Medium'"
                            class="challenges-page__segmented-item"
                            hx-get="?handler=UpdateList"
                            hx-target="#challengesAccordion"
                            hx-include="#filter-title, #filter-category, #filter-difficulty">Medium
                    </button>

                    <button type="button"
                            onclick="document.getElementById('filter-difficulty').value = '@ChallengeDifficulty.Hard'"
                            class="challenges-page__segmented-item"
                            hx-get="?handler=UpdateList"
                            hx-target="#challengesAccordion"
                            hx-include="#filter-title, #filter-category, #filter-difficulty">Hard
                    </button>
                </div>
            </div>

            <div class="col-12 col-lg-3">
                <select class="challenges-page__select"
                        name="CategoryName"
                        id="filter-category"
                        aria-label="Category filter"
                        hx-get="?handler=UpdateList"
                        hx-trigger="change"
                        hx-target="#challengesAccordion"
                        hx-include="#filter-title, #filter-difficulty">
                    <option value="">Category: All</option>
                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
        </div>
            <div class="table-responsive">
                <table class="table table-dark challenges-page__table mb-0 align-middle">
                    <tbody id="challengesAccordion"
                           hx-get="?handler=UpdateList"
                           hx-trigger="load"
                           hx-include="#filter-title, #filter-category, #filter-difficulty"
                           hx-target="this"
                           hx-swap="innerHTML">

                    @for (int i = 0; i < 7; i++)
                    {
                        <tr class="placeholder-wave bg-transparent">
                            <td class="ps-3"><span class="placeholder col-8 rounded placeholder-glow"></span></td>
                            <td></td>
                            <td><span class="placeholder col-8 rounded placeholder-glow"></span></td>
                            <td><span class="placeholder col-6 rounded placeholder-glow"></span></td>
                            <td><span class="placeholder col-5 rounded placeholder-glow"></span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
</section>

<script>
    document.addEventListener("click", function (e) {
        if (e.target.matches('.challenges-page__segmented-item')) {
            document.querySelectorAll('.challenges-page__segmented-item').forEach(b => b.classList.remove('is-active'));
            e.target.classList.add('is-active');
        }
    });
</script>

