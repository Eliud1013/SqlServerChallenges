@page "/Challenges/{slug}"
@model Detail
@{
    Layout = "_BaseLayout";
    ViewData["Title"] = Model.Info.Title;
    var challengeNumber = Model.Info.Number;
}

@section Styles {
    <link rel="stylesheet" href="~/css/Challenges/Detail.css" asp-append-version="true"/>
}

@Html.AntiForgeryToken()

<div class="challenge-detail bg-body">
    <header class="challenge-detail__subbar d-flex w-100 px-4">
        <a asp-page="Index" class="fw-bold fs-6 text-body link-underline link-underline-opacity-0 me-3">
            <img src="~/img/logo.svg" alt="SqlChallenges" class="challenge-detail__logo">
            <span>
                Sql<span class="text-primary">Challenges</span>
            </span>
        </a>

        <button class="challenge-detail__nav-arrow" title="Previous challenge">
            <i class="bi bi-arrow-left "></i>
        </button>

        <button class="challenge-detail__nav-arrow" title="Next challenge">
            <i class="bi bi-arrow-right "></i>
        </button>

        <button class="challenge-detail__nav-arrow" title="Random challenge">
            <i class="bi bi-shuffle "></i>
        </button>

    </header>
    <div class="challenge-detail__body">
        <div class="d-flex flex-grow-1 flex-shrink-1 flex-row p-3 gap-1">
            <aside class="challenge-detail__panel" id="challenge-detail-left">
                <div class="challenge-detail__tabs">
                    <button class="challenge-detail__tab is-active">Description</button>
                    <button class="challenge-detail__tab">Schema</button>
                    <button class="challenge-detail__tab">Comments</button>
                </div>

                <section class="challenge-detail__tab-panel is-active" data-tab="description" role="tabpanel">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="challenges-page__index challenges-page__index--small">
                            #@(challengeNumber < 10 ? $"0{challengeNumber}" : challengeNumber)
                        </span>
                        <span class="challenges__badge challenges__badge--category">@Model.Info.Category</span>
                        <span
                            class="challenges__badge challenge__badge--@Model.Info.Difficulty.ToString().ToLowerInvariant()">
                            @Model.Info.Difficulty
                        </span>
                        <span class="text-secondary ms-auto" style="font-size: 0.75rem">45% Acceptance</span>
                    </div>

                    <h1 class="challenge-detail__title">@Model.Info.Title</h1>
                    <p class="challenge-detail__description pt-2">@Model.Info.Description</p>
                    <div class="d-flex gap-2 mt-3">
                        <button id="vote-up"
                                class="challenge-detail__vote-btn @(Model.State.IsUpVoted ? "challenge-detail__vote-btn--clicked-up" : "")"
                                hx-post="?handler=Vote"
                                hx-vals='{"challengeId": "@Model.Info.ChallengeId", "type": "UpVote"}'
                                hx-swap="none"
                                hx-on::before-request="toggleVote('up')"
                                hx-on::after-request="if (!event.detail.successful) toggleVote('up')">
                            <i class="bi bi-hand-thumbs-up"></i>
                            <span class="challenge-detail__vote-count">@Model.State.UpVotes</span>
                        </button>

                        <button id="vote-down"
                                class="challenge-detail__vote-btn @(Model.State.IsDownVoted ? "challenge-detail__vote-btn--clicked-down" : "")"
                                hx-post="?handler=Vote"
                                hx-vals='{"challengeId": "@Model.Info.ChallengeId", "type": "DownVote"}'
                                hx-swap="none"
                                hx-on::before-request="toggleVote('down')"
                                hx-on::after-request="if (!event.detail.successful) toggleVote('down')">
                            <i class="bi bi-hand-thumbs-down"></i>
                        </button>
                    </div>

                    <h2 class="challenge-detail__label mt-4 pt-3">
                        <i class="bi bi-table me-1"></i>Expected output
                    </h2>

                    <div class="challenge-detail__sample">
                        <div class="challenge-detail__sample__body">
                            <partial name="_SampleOutput" model="@Model.Info.SampleOutput"/>
                        </div>
                    </div>
                </section>

                <section class="challenge-detail__tab-panel" data-tab="schema" role="tabpanel">
                    <h2 class="challenge-detail__label">
                        <i class="bi bi-diagram-3 me-1"></i>Table definitions
                    </h2>
                    <pre class="challenge-detail__schema">CREATE TABLE Person.Person (
    BusinessEntityID INT          NOT NULL,
    PersonType       NCHAR(2)     NOT NULL,
    NameStyle        BIT          NOT NULL,
    Title            NVARCHAR(8)  NULL,
    FirstName        NVARCHAR(50) NOT NULL,
    MiddleName       NVARCHAR(50) NULL,
    LastName         NVARCHAR(50) NOT NULL,
    EmailPromotion   INT          NOT NULL
);</pre>
                </section>

                <section class="challenge-detail__tab-panel" data-tab="comments" role="tabpanel">
                    <h2 class="challenge-detail__label">
                        <i class="bi bi-chat-left-text me-1"></i>Comments
                    </h2>
                    <div class="challenge-detail__chat">
                        <article class="challenge-detail__comment">
                            <span class="challenge-detail__comment-avatar">AR</span>
                            <div class="challenge-detail__comment-body">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="challenge-detail__comment-name">Alex Rivera</span>
                                    <span class="challenge-detail__comment-time">2 days ago</span>
                                </div>
                                <p class="challenge-detail__comment-text">
                                    Watch out: the sample output only includes people of type EM.
                                </p>
                            </div>
                        </article>
                        <article class="challenge-detail__comment">
                            <span class="challenge-detail__comment-avatar">SM</span>
                            <div class="challenge-detail__comment-body">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="challenge-detail__comment-name">Sam Miller</span>
                                    <span class="challenge-detail__comment-time">3 days ago</span>
                                </div>
                                <p class="challenge-detail__comment-text">
                                    SELECT * is enough for this one. Do not add an ORDER BY.
                                </p>
                            </div>
                        </article>
                    </div>
                </section>
            </aside>

            <div class="challenge-detail__workbench" id="challenge-detail-right">
                <header class="challenge-detail__workbench-bar">
                <span class="challenge-detail__workbench-title">
                    <i class="bi bi-terminal me-2"></i>T-SQL · SQL Server1
                </span>
                    <button type="button" class="btn btn-primary challenge-detail__run" id="challenge-detail-run">
                        <i class="bi bi-play-fill me-1" id="challenge-detail-run-icon"></i>
                        <span class="spinner-border spinner-border-sm me-1 d-none" id="challenge-detail-run-spinner"
                              role="status" aria-hidden="true"></span>
                        <span id="challenge-detail-run-text">Run</span>
                    </button>
                </header>

                <div class="d-flex flex-column flex-grow-1 flex-shrink-1">
                    <div class="challenge-detail__editor-wrap" id="challenge-detail-editor">
                    </div>
                    <section class="challenge-detail__results" id="challenge-detail-results">
                        <header class="challenge-detail__results-header">
                            <span class="challenge-detail__label challenge-detail__label--inline mb-0">Results</span>
                            <span class="challenge-detail__results-count d-none" id="challenge-detail-results-count">
                            <i class="bi bi-check-circle me-1"></i><span id="challenge-detail-row-count"></span>
                        </span>
                        </header>

                        <div class="challenge-detail__results-state" id="challenge-detail-results-idle">
                            <i class="bi bi-play-circle challenge-detail__results-icon" aria-hidden="true"></i>
                            <p>Press Run to see results</p>
                        </div>

                        <div class="challenge-detail__results-state d-none" id="challenge-detail-results-running">
                            <div class="spinner-border challenge-detail__results-spinner" role="status"
                                 aria-hidden="true"></div>
                            <p>Executing query...</p>
                        </div>

                        <div class="challenge-detail__results-table-wrap d-none"
                             id="challenge-detail-results-table-wrap">
                            <div class="table-responsive">
                                <table class="table challenge-detail__table mb-0">
                                    <thead>
                                    <tr>
                                        <th>BusinessEntityID</th>
                                        <th>PersonType</th>
                                        <th>FirstName</th>
                                        <th>LastName</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td>1</td>
                                        <td>EM</td>
                                        <td>Ken</td>
                                        <td>Sánchez</td>
                                    </tr>
                                    <tr>
                                        <td>2</td>
                                        <td>EM</td>
                                        <td>Terri</td>
                                        <td>Duffy</td>
                                    </tr>
                                    <tr>
                                        <td>3</td>
                                        <td>EM</td>
                                        <td>Roberto</td>
                                        <td>Tamburello</td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/split.js@1.6.5/dist/split.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs/loader.min.js"></script>

    <script>
        let editor;

        require.config({
            paths: {'vs': 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.45.0/min/vs'}
        });

        require(['vs/editor/editor.main'], function () {
            monaco.editor.defineTheme('mi-tema-sql', {
                base: 'vs-dark',
                inherit: true,
                rules: [
                    {token: 'keyword', foreground: '569CD6', fontStyle: 'bold'},
                    {token: 'string', foreground: 'CE9178'},
                    {token: 'comment', foreground: '6A9955'}
                ],
                colors: {
                    'editor.background': '#0D0F1B',
                    'editor.lineHighlightBackground': '#222222',
                    'editorCursor.foreground': '#00E676'
                }
            });

            editor = monaco.editor.create(document.getElementById('challenge-detail-editor'), {
                value: "SELECT\n    BusinessEntityID,\n    FirstName,\n    LastName\nFROM Person.Person\nWHERE PersonType = 'EM';",
                language: 'sql',
                theme: 'mi-tema-sql',
                fontFamily: 'Fira Code, Consolas, monospace',
                automaticLayout: false,
                fontSize: 14,
                minimap: {enabled: false},
                scrollBeyondLastLine: false,
                lineNumbers: 'on',
                roundedSelection: false,
                tabSize: 4
            });
        });
    </script>

    <script>
        function toggleVote(type) {
            const upBtn = document.getElementById('vote-up');
            const downBtn = document.getElementById('vote-down');
            const countSpan = upBtn.querySelector('.challenge-detail__vote-count');
            const count = parseInt(countSpan.textContent, 10);

            if (type === 'up') {
                const toggledOn = upBtn.classList.toggle('challenge-detail__vote-btn--clicked-up');
                downBtn.classList.remove('challenge-detail__vote-btn--clicked-down');
                countSpan.textContent = toggledOn ? count + 1 : count - 1;
            }

            if (type === 'down') {
                const toggledOn = downBtn.classList.toggle('challenge-detail__vote-btn--clicked-down');
                if (toggledOn && upBtn.classList.contains('challenge-detail__vote-btn--clicked-up')) {
                    upBtn.classList.remove('challenge-detail__vote-btn--clicked-up');
                    countSpan.textContent = count - 1;
                }
            }
        }

        (function () {
            Split(['#challenge-detail-left', '#challenge-detail-right'], {
                sizes: [150, 200],
                minSize: [350, 200],
                gutterSize: 6,
                direction: 'horizontal',
                cursor: 'col-resize',
                onDrag: () => editor?.layout(),
                onDragEnd: () => editor?.layout()
            });

            Split(['#challenge-detail-editor', '#challenge-detail-results'], {
                sizes: [60, 40],
                minSize: [160, 140],
                gutterSize: 6,
                direction: 'vertical',
                cursor: 'row-resize',
                onDrag: () => editor?.layout(),
                onDragEnd: () => editor?.layout()
            });

            const tabs = document.querySelectorAll('.challenge-detail__tab');
            const panels = document.querySelectorAll('.challenge-detail__tab-panel');

            tabs.forEach((tab) => {
                tab.addEventListener('click', () => {
                    const target = tab.textContent.trim().toLowerCase();
                    tabs.forEach((t) => t.classList.toggle('is-active', t === tab));
                    panels.forEach((p) => p.classList.toggle('is-active', p.dataset.tab === target));
                });
            });

            const runBtn = document.getElementById('challenge-detail-run');
            const runIcon = document.getElementById('challenge-detail-run-icon');
            const runSpinner = document.getElementById('challenge-detail-run-spinner');
            const runText = document.getElementById('challenge-detail-run-text');
            const idle = document.getElementById('challenge-detail-results-idle');
            const running = document.getElementById('challenge-detail-results-running');
            const tableWrap = document.getElementById('challenge-detail-results-table-wrap');
            const resultsCount = document.getElementById('challenge-detail-results-count');
            const rowCount = document.getElementById('challenge-detail-row-count');

            runBtn.addEventListener('click', () => {
                if (runBtn.disabled) return;
                runBtn.disabled = true;
                runIcon.classList.add('d-none');
                runSpinner.classList.remove('d-none');
                runText.textContent = 'Running...';
                idle.classList.add('d-none');
                running.classList.remove('d-none');

                setTimeout(() => {
                    runBtn.disabled = false;
                    runIcon.classList.remove('d-none');
                    runSpinner.classList.add('d-none');
                    runText.textContent = 'Run';
                    running.classList.add('d-none');
                    tableWrap.classList.remove('d-none');
                    rowCount.textContent = '3 rows';
                    resultsCount.classList.remove('d-none');
                }, 900);
            });
        })();
    </script>
}
