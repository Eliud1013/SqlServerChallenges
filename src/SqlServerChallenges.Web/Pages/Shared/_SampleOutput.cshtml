@using SqlServerChallenges.Core.Common.Results
@using SqlServerChallenges.Core.Services.QueryExecutor

@model OutputTable

@{
    OutputTable? queryResult = Model;
}

@if (queryResult == null)
{
    <p class="text-muted font-monospace" style="font-size: 0.75rem">Sample not available</p>
    return;
}

<table class="table table-sm table-borderless mb-0">
    <thead>
    <tr>
        @foreach (var column in queryResult.Columns)
        {
            <th>@column</th>
        }
    </tr>
    </thead>
    <tbody>
    @foreach (var row in queryResult.Rows)
    {
        <tr>
            @foreach (var cell in row.Values)
            {
                string? cellValue = cell?.ToString();

                if (string.IsNullOrEmpty(cellValue))
                {
                    <td>-</td>
                }
                else if (cellValue?.Length > 20)
                {
                    <td>@cellValue.Substring(0, 20)...</td>
                }
                else
                {
                    <td>@cellValue</td>
                }
            }
        </tr>
    }
    </tbody>
</table>
